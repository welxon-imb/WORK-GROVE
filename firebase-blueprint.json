{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile and wallet balances",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique auth UID of user" },
        "name": { "type": "string", "description": "Full display name" },
        "email": { "type": "string", "description": "Email address of user" },
        "mobile": { "type": "string", "description": "Contact mobile number" },
        "totalBalance": { "type": "number", "description": "Total combined wallet balance" },
        "incomeBalance": { "type": "number", "description": "Balance earned from tasks" },
        "referBalance": { "type": "number", "description": "Balance earned from referrals" },
        "pendingBalance": { "type": "number", "description": "Balance awaiting review" },
        "withdrawBalance": { "type": "number", "description": "Balance ready for withdrawal" },
        "referrals": { "type": "number", "description": "Count of referred users" },
        "verified": { "type": "boolean", "description": "Whether user is verified" },
        "premium": { "type": "boolean", "description": "Whether user is a premium member" },
        "createdAt": { "type": "string", "description": "Account registration timestamp" }
      },
      "required": ["uid", "name", "email", "totalBalance", "incomeBalance"]
    },
    "Job": {
      "title": "Job",
      "description": "Micro jobs posted on Work Grove",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique job ID" },
        "title": { "type": "string", "description": "Job title" },
        "category": { "type": "string", "description": "Job category" },
        "reward": { "type": "number", "description": "Payout reward per task completion" },
        "completed": { "type": "number", "description": "Number of workers completed" },
        "total": { "type": "number", "description": "Total workers needed" },
        "employer": { "type": "string", "description": "Name of posting employer" },
        "employerId": { "type": "string", "description": "UID of employer" },
        "proofInstruction": { "type": "string", "description": "Instructions for submitting proof" },
        "status": { "type": "string", "enum": ["active", "completed"], "description": "Current status" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["title", "category", "reward", "completed", "total", "status"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Task proof submissions by workers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique submission ID" },
        "jobId": { "type": "string", "description": "Associated job ID" },
        "jobTitle": { "type": "string", "description": "Title of the job" },
        "workerId": { "type": "string", "description": "UID of submitting worker" },
        "workerName": { "type": "string", "description": "Worker display name" },
        "proofText": { "type": "string", "description": "Submitted proof details or link" },
        "reward": { "type": "number", "description": "Reward amount" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Review status" },
        "createdAt": { "type": "string", "description": "Submission timestamp" }
      },
      "required": ["jobId", "workerId", "proofText", "reward", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial ledger transactions including deposit, withdrawal and earnings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Transaction ID" },
        "userId": { "type": "string", "description": "User UID who owns this transaction" },
        "type": { "type": "string", "enum": ["Deposit", "Withdraw", "Refer", "Earn"], "description": "Type of transaction" },
        "amount": { "type": "number", "description": "Transaction amount in BDT" },
        "paymentMethod": { "type": "string", "description": "Method such as bKash, Nagad, Rocket" },
        "accountNumber": { "type": "string", "description": "Mobile account number" },
        "trxId": { "type": "string", "description": "Payment transaction ID" },
        "status": { "type": "string", "enum": ["Success", "Pending", "Processing"], "description": "Status" },
        "date": { "type": "string", "description": "Human readable date" },
        "createdAt": { "type": "string", "description": "Timestamp" }
      },
      "required": ["userId", "type", "amount", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "User notifications, announcements, and support updates",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message ID" },
        "userId": { "type": "string", "description": "Recipient UID or broadcast" },
        "sender": { "type": "string", "description": "Sender name or channel" },
        "content": { "type": "string", "description": "Message body" },
        "time": { "type": "string", "description": "Relative time string" },
        "unread": { "type": "boolean", "description": "Whether message is unread" },
        "type": { "type": "string", "enum": ["announcement", "support", "notification"], "description": "Category" },
        "createdAt": { "type": "string", "description": "Timestamp" }
      },
      "required": ["sender", "content", "unread", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User account documents keyed by user UID"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Micro job listings available to workers"
    },
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Worker submitted task proofs"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial ledger transactions"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "User alerts and notifications"
    }
  }
}
